# --- Local docker-compose ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_NAME=wordpress
MYSQL_ROOT_PASSWORD=rootpass

WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change-me-strong
WORDPRESS_ADMIN_EMAIL=admin@supremeautoparts.co.ke
WORDPRESS_TITLE=Supreme Autoparts

WOO_CURRENCY=KES
SUPREME_SEED_ON_BOOT=1
# Free-shipping threshold in store currency units (document; configure in Woo settings)
SUPREME_FREE_SHIPPING_THRESHOLD=15000

# --- Railway MySQL plugin mapping ---
# Railway injects MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE.
# The entrypoint maps those to WORDPRESS_DB_* automatically when WORDPRESS_DB_HOST is unset.
# Example Railway service variables (set in Railway dashboard — do not commit secrets):
#   MYSQLHOST=<from MySQL plugin>
#   MYSQLPORT=3306
#   MYSQLUSER=<from MySQL plugin>
#   MYSQLPASSWORD=<from MySQL plugin>
#   MYSQLDATABASE=<from MySQL plugin>
#   WP_HOME=https://supremeautoparts.co.ke
#   WP_SITEURL=https://supremeautoparts.co.ke
#   WORDPRESS_ADMIN_USER=...
#   WORDPRESS_ADMIN_PASSWORD=...
#   WORDPRESS_ADMIN_EMAIL=...
# Attach a volume to /var/www/html/wp-content/uploads for media persistence.

# --- Whop payment gateway (Railway secrets — do not commit real values) ---
# Get keys at https://whop.com (or https://sandbox.whop.com for sandbox)
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
# 1 = sandbox-api.whop.com ; 0 or unset with admin checkbox = production
WHOP_SANDBOX=1

# Boot-time import of baked Shopify batch (Railway)
SUPREME_IMPORT_ON_BOOT=1
SUPREME_IMPORT_LIMIT=400
# 1 = store CDN meta only (fast); 0 = also sideload into Media Library
SUPREME_IMPORT_SKIP_IMAGES=1
# SUPREME_IMPORT_FILE=/var/www/html/wp-content/plugins/supreme-autoparts-core/data/scrape/chunks/batch-with-images-400.ndjson
