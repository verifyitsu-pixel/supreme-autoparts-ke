# --- Local docker-compose ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_NAME=wordpress
MYSQL_ROOT_PASSWORD=rootpass

WP_HOME=http://localhost:8080
# Production: https://www.supremeautoparts.co.ke
WP_SITEURL=http://localhost:8080

WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change-me-strong
WORDPRESS_ADMIN_EMAIL=calvin@supremeautoparts.co.ke
WORDPRESS_TITLE=Supreme Autoparts

# WooCommerce transactional email identity (also seeded by wordpress-entrypoint.sh)
# From name: Supreme Autoparts
# From address: same as WORDPRESS_ADMIN_EMAIL (calvin@supremeautoparts.co.ke)
# Deliverability: set BREVO_API_KEY (preferred) or BREVO_SMTP_* — see Brevo section below.

WOO_CURRENCY=USD
SA_CHECKOUT_CURRENCY=USD
SA_GEO_CURRENCY=1
# Optional FX endpoint (default https://open.er-api.com/v6/latest/USD)
# SA_FX_API_URL=
SUPREME_SEED_ON_BOOT=1
# Free-shipping threshold in store currency units (USD). Document; configure in Woo settings.
SUPREME_FREE_SHIPPING_THRESHOLD=115

# --- Railway MySQL plugin mapping ---
# Railway injects MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE.
# The entrypoint maps those to WORDPRESS_DB_* automatically when WORDPRESS_DB_HOST is unset.
# Example Railway service variables (set in Railway dashboard — do not commit secrets):
#   MYSQLHOST=<from MySQL plugin>
#   MYSQLPORT=3306
#   MYSQLUSER=<from MySQL plugin>
#   MYSQLPASSWORD=<from MySQL plugin>
#   MYSQLDATABASE=<from MySQL plugin>
#   WP_HOME=https://www.supremeautoparts.co.ke
#   WP_SITEURL=https://www.supremeautoparts.co.ke
#   WORDPRESS_ADMIN_USER=...
#   WORDPRESS_ADMIN_PASSWORD=...
#   WORDPRESS_ADMIN_EMAIL=calvin@supremeautoparts.co.ke
# Attach a volume to /var/www/html/wp-content/uploads for media persistence.

# --- Whop payment gateway (Railway secrets — do not commit real values) ---
# Get keys at https://whop.com (or https://sandbox.whop.com for sandbox)
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
# 1 = sandbox-api.whop.com ; 0 or unset with admin checkbox = production
WHOP_SANDBOX=1
# Webhook URL (register in Whop dashboard): https://www.supremeautoparts.co.ke/?wc-api=whop_webhook

# Boot-time import of baked Shopify batch (Railway)
# Safe default: category=brakes, limit=50, prefer batch-400 then batch-50 (not auto-2000).
# Empty catalog (0 published products) always re-imports even when ON_BOOT=0.
# SUPREME_FORCE_IMPORT=1 clears sa_boot_import_* and re-imports on next boot (set briefly, then back to 0).
SUPREME_IMPORT_ON_BOOT=0
SUPREME_FORCE_IMPORT=0
SUPREME_RECOVER_TOKEN=
SUPREME_IMPORT_CATEGORY=brakes
SUPREME_IMPORT_LIMIT=50
# 1 = store CDN meta only (fast); 0 = also sideload into Media Library
SUPREME_IMPORT_SKIP_IMAGES=1
# SUPREME_IMPORT_FILE=/var/www/html/wp-content/plugins/supreme-autoparts-core/data/scrape/chunks/batch-with-images-400.ndjson
# SUPREME_IMPORT_MAPPING=/var/www/html/wp-content/plugins/supreme-autoparts-core/data/product-type-parent-map.json

SUPREME_STORE_EMAIL=calvin@supremeautoparts.co.ke

# --- Brevo transactional + marketing (Railway secrets — do not commit real values) ---
# Create API key at https://app.brevo.com → SMTP & API → API keys
BREVO_API_KEY=
# Contact list for marketing opt-in sync (numeric list id from Brevo)
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=calvin@supremeautoparts.co.ke
BREVO_SENDER_NAME=Supreme Autoparts
# Optional SMTP fallback (smtp-relay.brevo.com) if API path unavailable
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_SMTP_SECURE=tls
# Optional webhook secret for POST /wp-json/sa-brevo/v1/webhook
BREVO_WEBHOOK_SECRET=
